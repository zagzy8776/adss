# Local scratch + tooling output. NOTE: _headers and _redirects must stay
# tracked — Netlify and Cloudflare Pages read them at deploy time.
node_modules/
worker/.wrangler/
.wrangler/

# Chrome profiles and screenshots used for local checks
_cp*/
_cprof*/
_*.png
_*.mjs
_*.js

# Logs
*.log

# Local backups of pages that already live in git. These would otherwise be
# served as public files (/index.html.backup).
*.backup
